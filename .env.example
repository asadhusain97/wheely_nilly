# Run `cd backend && npm run setup` to create your local .env automatically.

# SnapTrade Personal API key: https://dashboard.snaptrade.com/api-key
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_ACCOUNT_IDS=

# Background opportunity alerts run during US market hours when ALERTS_ENABLED=true.
OPPORTUNITY_SCAN_CRON=*/15 10-15 * * 1-5
OPPORTUNITY_SCAN_TIMEZONE=America/New_York
DASHBOARD_PUBLIC_URL=
