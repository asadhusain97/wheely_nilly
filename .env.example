# Public origin for this deployment. Do not include a trailing slash.
APP_ORIGIN=http://127.0.0.1:3000

# SnapTrade confidential OAuth application. These values stay server-side.
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=

# 32 random bytes encoded as base64url. Generate once per environment.
SESSION_SEAL_KEY=

# Optional market request timeout in seconds.
MARKET_TIMEOUT_SECONDS=15
