# Runtime
NODE_ENV=production
TZ=UTC
BACKEND_PORT=3000
# Direct Node runs remain loopback-only; Compose overrides this inside the container.
SERVER_HOST=127.0.0.1
DASHBOARD_BIND_ADDRESS=127.0.0.1

# SnapTrade server-side credentials. Never expose these to frontend code.
# Personal API key mode (recommended for this self-hosted dashboard):
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Commercial API key apps only. Leave BOTH empty for Personal mode.
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=
SNAPTRADE_BROKERAGE_AUTHORIZATION_ID=

# Phase 1 ingestion. Pin the intended SnapTrade account IDs (comma-separated)
# after discovering them via GET /api/v1/snaptrade/accounts.
SNAPTRADE_ACCOUNT_IDS=
INGEST_ENABLED=true
INGEST_CRON=*/30 * * * *
INGEST_ACTIVITIES_DAYS=90
INGEST_ORDERS_DAYS=90
INGEST_STALE_AFTER_MINUTES=60
SNAPTRADE_TIMEOUT_MS=20000
RETRY_ATTEMPTS=3
RETRY_BASE_MS=500
# Optional override; defaults to ./data
DATA_DIR=

# Phase 3 screener
PYTHON_SIDECAR_URL=http://screener:8000
SCREENER_PROVIDER=yfinance
ALPHAVANTAGE_API_KEY=

# Phase 4 notifications
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
