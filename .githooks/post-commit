#!/bin/sh
set -eu

changed_files=$(git diff-tree --no-commit-id --name-only -r HEAD)

if printf '%s\n' "$changed_files" | grep -Eq '^(api|frontend)/|^(vercel\.json|package\.json|package-lock\.json)$'; then
  printf '\nWheely Nilly application code changed. Push main to deploy the Vercel project.\n\n'
fi
