{
  "name": "wheel-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Local API and job runner for the Wheel Strategy dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "app": "node scripts/start-local.js",
    "setup": "node scripts/setup.js",
    "check": "node --check src/server.js",
    "check:snaptrade": "node scripts/check-snaptrade-connection.js",
    "register:snaptrade-user": "node scripts/register-snaptrade-user.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "snaptrade-typescript-sdk": "^12.1.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
