[Unit]
Description=Wheely Nilly dashboard and scheduler
After=network-online.target wheely-nilly-screener.service
Wants=network-online.target
Requires=wheely-nilly-screener.service

[Service]
Type=simple
User=asadhusain97
Group=asadhusain97
WorkingDirectory=/home/asadhusain97/wheely_nilly/backend
EnvironmentFile=/home/asadhusain97/wheely_nilly/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=SERVER_HOST=127.0.0.1
Environment=PYTHON_SIDECAR_URL=http://127.0.0.1:8000
ExecStart=/opt/node-v22.23.2/bin/node src/server.js
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/asadhusain97/wheely_nilly/data

[Install]
WantedBy=multi-user.target
